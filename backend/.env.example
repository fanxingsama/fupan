# Default Tushare collector requires an API token and optional proxy URL.
TUSHARE_TOKEN=
TUSHARE_HTTP_URL=

# Optional AI recap settings
AI_ENABLED=true
AI_PROVIDER=litellm
AI_API_KEY=sk-local-litellm
AI_BASE_URL=http://127.0.0.1:4000/v1
AI_MODEL=recap-main
AI_TIMEOUT_SECONDS=120

# LiteLLM upstream example
LITELLM_MASTER_KEY=sk-local-litellm
MINIMAX_API_BASE=https://api.minimaxi.com/v1
MINIMAX_API_KEY=your-minimax-key
